{
  "name": "zauterm",
  "private": true,
  "version": "3.3.1",
  "description": "A cross-platform terminal emulator built with Tauri, React, and xterm.js, supporting SSH, SFTP, serial, and Telnet",
  "type": "module",
  "homepage": "https://github.com/zhuhezhang/zauterm",
  "homepageBackup": "https://gitee.com/zhuhezhang/zauterm",
  "desktopName": "ZauTerm.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/rename-tauri-artifacts.mjs",
    "rename:artifacts": "node scripts/rename-tauri-artifacts.mjs",
    "mod:ver": "node scripts/modify-project-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "cargo:check": "cd src-tauri && cargo check",
    "cargo:test": "cd src-tauri && cargo test",
    "project:check": "npm run typecheck && npm run lint && npm run test && npm run cargo:check && npm run cargo:test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "zhuhezhang",
    "email": "zhuhezhang@qq.com",
    "url": "https://github.com/zhuhezhang/zauterm",
    "urlBackup": "https://gitee.com/zhuhezhang/zauterm"
  },
  "license": "MIT"
}
